# Project Apricorn Environment Configuration Template
SERVER_PORT=8080

# PostgreSQL Persistence
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/apricorn_db
SPRING_DATASOURCE_USERNAME=apricorn_user
SPRING_DATASOURCE_PASSWORD=apricorn_password

# JWT Authentication Configuration
# Replace with a cryptographically secure 256-bit key in production
JWT_SECRET=your_super_secret_key_at_least_32_bytes_long_1234567890
JWT_EXPIRATION=3600000

# Online Judge Engine Configuration
JUDGE_MODE=stub
