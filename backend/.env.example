# Project Apricorn — Production Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR CREATED .env FILES TO SOURCE CONTROL.

# Application Active Profile
SPRING_PROFILES_ACTIVE=prod

# Server Port
SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apricorn
DB_USERNAME=apricorn
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# Security & JWT Configuration (JWT_SECRET MUST BE AT LEAST 32 CHARACTERS LONG)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRATION_MS=3600000

# Judge Execution Engine Mode (docker)
JUDGE_MODE=docker
